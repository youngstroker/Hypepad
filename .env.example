# Copy to .env and fill in. Every secret here stays on the server.

# ---- web
# Host Caddy serves and gets HTTPS for: api.your-domain.com when the site is on Vercel,
# or your-domain.com when this server serves everything
DOMAIN=api.your-domain.com
# The address users visit (your Vercel domain). Written into every coin's on-chain
# metadata, so it must be final before launch.
PUBLIC_URL=https://your-domain.com
PORT=4191
HOST=127.0.0.1
SITE_NAME=HyperPump
# number of proxies in front of the app (Caddy = 1); docker-compose sets this
TRUST_PROXY=1
# Shared with the Vercel project's PROXY_SECRET env var: lets requests forwarded
# by Vercel report the visitor's real IP for rate limiting. Use a long random value.
PROXY_SECRET=
# SQLite database + uploaded images (back this up)
DATA_DIR=./data

# ---- Solana (where users pay)
# mainnet-beta | devnet
SOLANA_CLUSTER=mainnet-beta
# the public RPC rate-limits hard; use Helius/Triton/QuickNode
SOLANA_RPC_URL=https://your-paid-rpc.example
TREASURY_PUBLIC_KEY=
# base58 or JSON array. Optional: without it refunds are queued for `npm run admin`
TREASURY_SECRET_KEY=

# ---- HyperEVM (where coins live)
HYPEREVM_CHAIN_ID=999
# Server-only RPC for the relayer and indexer. Use a dedicated provider: the
# public endpoint allows ~100 requests/min per IP. May contain an API key.
HYPEREVM_RPC_URL=https://your-hyperevm-rpc.example
# Optional separate RPC for visitor-driven reads (quotes, balances).
# HYPEREVM_READ_RPC_URL=
# Sent to browsers and added to users' wallets: must be a public URL with no key.
PUBLIC_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_EXPLORER=https://hyperevmscan.io
# From contracts/deployments/hyperevm.json after deploying (required on mainnet)
FACTORY_ADDRESS=
FACTORY_DEPLOY_BLOCK=
# Approved launcher; holds the HYPE that funds buys. Must stay on SMALL blocks.
RELAYER_PRIVATE_KEY=
# Separate key that sends migrate() (~3.7M gas, more than a 3M small block).
# Required on mainnet; switch it to big blocks with: npm run big-blocks -- on
MIGRATOR_PRIVATE_KEY=
RELAYER_GAS_RESERVE_HYPE=0.5

# ---- economics
LAUNCH_FEE_SOL=0.05
# SOL->HYPE conversion spread kept by the platform, shown to users
CONVERSION_SPREAD_BPS=100
MIN_BUY_SOL=0.01
MAX_ORDER_SOL=25
QUOTE_TTL_SECONDS=600

# ---- prices
PRICE_MAX_DIVERGENCE_BPS=300
# PRICE_FIXED_SOL_USD=   local chain only; refused on mainnet
# PRICE_FIXED_HYPE_USD=
